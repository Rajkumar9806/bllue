# bllue Backend Environment Variables

# Database - Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.neon.tech/bllue?sslmode=require

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# Twilio SMS OTP
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=bllue-app
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# OpenAI for AI suggestions
OPENAI_API_KEY=your-openai-api-key

# App Settings
APP_NAME=bllue
APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=https://bllue.app,exp://localhost:8081

# Social Media APIs (optional)
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_API_KEY=
